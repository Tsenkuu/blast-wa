# ===================================================
# WA BLAST MANAGER PRO - BACKEND ENVIRONMENT CONFIG
# ===================================================

# Port & Environment
NODE_ENV=production
PORT=5000

# Security Secrets (Harap ganti dengan string acak yang kuat)
JWT_SECRET=change_this_to_a_very_secure_random_string_32_chars_min
JWT_EXPIRES_IN=24h

# Database Configuration (MySQL)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wa_blast_user
DB_PASSWORD=your_secure_db_password
DB_NAME=wa_blast_pro

# Directory Paths
DATA_DIR=/var/www/wa-blast/data
UPLOAD_DIR=/var/www/wa-blast/data/uploads
SESSIONS_DIR=/var/www/wa-blast/data/sessions
MAX_FILE_SIZE_MB=25

# Anti-Ban & Broadcast Queue Safety
MESSAGE_DELAY_MIN_MS=3000
MESSAGE_DELAY_MAX_MS=6000
MAX_RETRY_LIMIT=2
CIRCUIT_BREAKER_FAIL_STREAK=5
CIRCUIT_BREAKER_FAIL_RATE=0.25

# Initial Seeding Credentials (Hanya dipakai saat seeding awal)
DEFAULT_ADMIN_PASSWORD=Admin@GantiIniSegera2026

# CORS Origin (pisahkan dengan koma jika lebih dari satu domain)
CORS_ORIGIN=https://blast.yourdomain.com,http://localhost:3000

# Mode Mock untuk Testing Otomatis (false untuk produksi nyata)
WA_USE_MOCK=false
