# ===================================================
# WA BLAST MANAGER PRO - GLOBAL ENVIRONMENT CONFIG
# ===================================================

NODE_ENV=production
PORT=5000

# Security Secrets
JWT_SECRET=change_this_to_a_very_secure_random_string_32_chars_min
JWT_EXPIRES_IN=24h

# Database Configuration (MySQL)
DB_CLIENT=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=wa_blast_user
DB_PASSWORD=wa_blast_secure_password_2026
DB_NAME=wa_blast_pro

# Directory Paths
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
SESSIONS_DIR=/app/data/sessions
MAX_FILE_SIZE_MB=25

# Anti-Ban & Broadcast Queue Safety
MESSAGE_DELAY_MIN_MS=3000
MESSAGE_DELAY_MAX_MS=6000
MAX_RETRY_LIMIT=2
CIRCUIT_BREAKER_FAIL_STREAK=5
CIRCUIT_BREAKER_FAIL_RATE=0.25

# Initial Seeding Credentials
DEFAULT_ADMIN_PASSWORD=Admin@WA2026Secure

# CORS Origin
CORS_ORIGIN=http://localhost,http://localhost:3000,http://localhost:80

# Baileys / WhatsApp Adapter
WA_USE_MOCK=false
